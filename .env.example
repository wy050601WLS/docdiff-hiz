# ===== 大模型配置（OpenAI 兼容接口）=====

# 方案 A（默认）：本地 Ollama，无需联网、无需 API Key
# 先确保已安装 Ollama 并拉取模型：ollama pull qwen3.5:9b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b

# 方案 B：任意云端 OpenAI 兼容接口（需要时把上面三行替换掉）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# 本地小模型推理慢，超时给足（秒）
LLM_TIMEOUT=300

# 关闭大模型，完全走离线规则报告（true / false）
LLM_ENABLED=true

# 本机 Ollama 自动改走原生 /api/chat 并关闭思考模式，
# 思考型模型（qwen3.5 等）问答从 ~40s 降到 ~2s；换云端供应商时不受影响
LLM_NATIVE_OLLAMA=true
LLM_DISABLE_THINK=true

# ===== 应用配置 =====
APP_PORT=8000
